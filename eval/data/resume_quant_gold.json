    },
    {
      "id": "shop_partial_milk_ml",
      "required": [{"name": "牛奶", "amount": 500, "unit": "ml"}],
      "inventory": {"牛奶": {"amount": 200, "unit": "ml"}},
      "expected_shopping": [{"name": "牛奶", "amount": 300, "unit": "ml"}]
    },
    {
      "id": "shop_unit_convert_g",
      "required": [{"name": "五花肉", "amount": 500, "unit": "g"}],
      "inventory": {"五花肉": {"amount": 0.2, "unit": "kg"}},
      "expected_shopping": [{"name": "五花肉", "amount": 300, "unit": "g"}]
    },
    {
      "id": "shop_sufficient_zero_gap",
      "required": [{"name": "鸡蛋", "amount": 3, "unit": "个"}],
      "inventory": {"鸡蛋": {"amount": 10, "unit": "个"}},
      "expected_shopping": []
    }
  ],

  "l2_summary_must_preserve": {
    "seed_turns": [
      {"role": "human", "content": "我对花生严重过敏，千万别推荐含花生的菜。"},
      {"role": "ai", "content": "已记录：菜谱与清单会避开花生及相关制品。"},
      {"role": "human", "content": "另外我想周末做酸菜鱼。"},
      {"role": "ai", "content": "好的，可以为您检索酸菜鱼菜谱并计算食材缺口。"}
