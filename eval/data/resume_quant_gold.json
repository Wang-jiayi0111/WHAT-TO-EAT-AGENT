{
  "version": 1,
  "description": "简历量化指标黄金集：意图三分类、多轮澄清、跨会话约束、购物清单、L2 摘要保留词（与 eval/run_resume_quant_metrics.py 配套）",

  "intent_bucket_gold": [
    {"id": "ib_search_dish", "utterance": "我想做红烧肉，帮我找几个做法。", "expect_bucket": "retrieval"},
    {"id": "ib_inv_check", "utterance": "冰箱里还有肉吗？", "expect_bucket": "inventory"},
    {"id": "ib_shopping", "utterance": "看看做麻婆豆腐还差什么要买。", "expect_bucket": "inventory"},
    {"id": "ib_inv_add", "utterance": "超市买了鸡蛋一盒、牛奶两瓶。", "expect_bucket": "inventory"},
    {"id": "ib_chat_weather", "utterance": "今天天气真不错。", "expect_bucket": "chat"},
    {"id": "ib_help", "utterance": "你能做什么？", "expect_bucket": "chat"},
    {"id": "ib_out_of_scope", "utterance": "帮我写一段 Python 快速排序。", "expect_bucket": "chat"},
    {"id": "ib_dietary", "utterance": "我感冒了，饮食上有什么要注意的？", "expect_bucket": "chat"},
    {"id": "ib_profile", "utterance": "帮我记下，我对花生过敏。", "expect_bucket": "chat"},
    {"id": "ib_recipe_adopt", "utterance": "就按第一个菜谱做吧。", "expect_bucket": "retrieval"},
    {"id": "ib_commit_done", "utterance": "刚才的清蒸鱼做好了。", "expect_bucket": "inventory"},
    {
      "id": "ib_multi_gap",
      "utterance": "买了点猪肉，想做红烧肉，看看还差什么。",
      "expect_bucket_any": ["retrieval", "inventory"]
    }
  ],

  "clarification_flows": [
    {
      "id": "vague_then_named_dish",
      "turns": [
        {
          "user": "随便推荐个菜吧，再看看缺啥要买。",
          "expect_clarify_path": true,
          "expect_primary_one_of": ["recipe_search", "shopping_list", "general_chat", "user_clarify"]
        },
        {
          "assistant": "好的，需要先确认您更想先看菜谱还是优先列购物清单。",
          "user": "那就做酸菜鱼吧，只要菜谱。",
          "expect_clarify_path": false,
          "expect_primary_one_of": ["recipe_search", "general_chat"]
        }
      ]
    },
    {
      "id": "underspecified_inv_then_anchor",
      "turns": [
        {
          "user": "看看冰箱里还有吗？",
          "expect_clarify_path": true,
          "expect_primary_one_of": ["inventory_check", "general_chat", "user_clarify"]
        },
        {
          "assistant": "请问您想查哪一种食材？",
          "user": "鸡蛋还有几个？",
          "expect_clarify_path": false,
          "expect_primary_one_of": ["inventory_check", "general_chat"]
        }
      ]
    }
  ],

